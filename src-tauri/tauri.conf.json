{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PrintGuardian",
  "version": "0.3.0-dev.14",
  "identifier": "lv.craftin.printguardian",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; connect-src 'self' ipc: http://ipc.localhost https://api.github.com; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; frame-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "CraftIN / QvarcY",
    "category": "Utility",
    "shortDescription": "Local-first 3D print project inspector",
    "longDescription": "PrintGuardian inspects 3MF projects locally, explains important slicer settings and helps prepare reviewed copies before printing.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "allowDowngrades": false,
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": true,
        "languages": [
          "English",
          "Latvian"
        ],
        "customLanguageFiles": {
          "Latvian": "windows/Latvian.nsh"
        },
        "installerHooks": "windows/nsis-hooks.nsh"
      }
    },
    "homepage": "https://github.com/QvarcY/PrintGuardian",
    "copyright": "© 2026 CraftIN / QvarcY"
  }
}
