{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Minimal desktop permissions for the PrintGuardian main window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-save",
    "fs:allow-write-file",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://buymeacoffee.com/craftin*" },
        { "url": "https://github.com/QvarcY/PrintGuardian*" },
        { "url": "https://kas.id.lv*" },
        { "url": "https://craftin.lv*" }
      ]
    }
  ]
}
